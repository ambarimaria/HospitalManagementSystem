@model HospitalManagementSystem.Models.Staff
@{
    ViewData["Title"] = "Add Staff Member";
}
<div class="page-header">
    <div class="flex items-center gap-4">
        <a href="@Url.Action("Index")" class="btn btn-outline btn-sm"><i class="fas fa-arrow-left"></i></a>
        <div class="page-title">Add Staff Member</div>
    </div>
</div>
<div class="card" style="max-width:640px;">
    <div class="card-body">
        <form asp-action="Create" method="post">
            @Html.AntiForgeryToken()
            <div asp-validation-summary="All" class="alert alert-danger"></div>
            <div class="form-row">
                <div class="form-group"><label asp-for="FirstName" class="form-label required"></label><input asp-for="FirstName" class="form-control"/></div>
                <div class="form-group"><label asp-for="LastName" class="form-label required"></label><input asp-for="LastName" class="form-control"/></div>
            </div>
            <div class="form-row">
                <div class="form-group">
                    <label asp-for="Role" class="form-label required">Role</label>
                    <select asp-for="Role" class="form-control form-select">
                        <option value="">Select role…</option>
                        @foreach(var r in new[]{"Head Nurse","Nurse","Lab Technician","Pharmacist","Receptionist","Radiologist","Physiotherapist","Dietitian","Security","Housekeeping","Administrator","Accountant"})
                        {<option>@r</option>}
                    </select>
                </div>
                <div class="form-group">
                    <label asp-for="DepartmentId" class="form-label">Department</label>
                    <select asp-for="DepartmentId" class="form-control form-select">
                        <option value="">General / No dept</option>
                        @foreach(var d in ViewBag.Departments as List<HospitalManagementSystem.Models.Department> ?? new())
                        {<option value="@d.Id">@d.Name</option>}
                    </select>
                </div>
            </div>
            <div class="form-row">
                <div class="form-group"><label asp-for="Phone" class="form-label required"></label><input asp-for="Phone" class="form-control"/></div>
                <div class="form-group"><label asp-for="Email" class="form-label"></label><input asp-for="Email" class="form-control"/></div>
            </div>
            <div class="flex gap-3"><button type="submit" class="btn btn-primary"><i class="fas fa-save"></i> Add Staff</button><a href="@Url.Action("Index")" class="btn btn-outline">Cancel</a></div>
        </form>
    </div>
</div>
