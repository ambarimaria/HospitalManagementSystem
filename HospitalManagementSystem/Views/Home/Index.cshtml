@model HospitalManagementSystem.ViewModels.DashboardViewModel
@{
    ViewData["Title"] = "Dashboard";
}

<div class="stats-grid">
    <div class="stat-card">
        <div class="stat-icon blue"><i class="fas fa-user-injured"></i></div>
        <div><div class="stat-value">@Model.TotalPatients</div><div class="stat-label">Total Patients</div></div>
    </div>
    <div class="stat-card">
        <div class="stat-icon green"><i class="fas fa-calendar-check"></i></div>
        <div><div class="stat-value">@Model.TodayAppointments</div><div class="stat-label">Today's Appointments</div></div>
    </div>
    <div class="stat-card">
        <div class="stat-icon teal"><i class="fas fa-bed"></i></div>
        <div><div class="stat-value">@Model.AvailableBeds</div><div class="stat-label">Available Beds</div></div>
    </div>
    <div class="stat-card">
        <div class="stat-icon purple"><i class="fas fa-user-md"></i></div>
        <div><div class="stat-value">@Model.TotalDoctors</div><div class="stat-label">Active Doctors</div></div>
    </div>
    <div class="stat-card">
        <div class="stat-icon orange"><i class="fas fa-dollar-sign"></i></div>
        <div><div class="stat-value">$@Model.TodayRevenue.ToString("N0")</div><div class="stat-label">Today's Revenue</div></div>
    </div>
    <div class="stat-card">
        <div class="stat-icon yellow"><i class="fas fa-file-invoice-dollar"></i></div>
        <div><div class="stat-value">@Model.PendingBills</div><div class="stat-label">Pending Bills</div></div>
    </div>
    <div class="stat-card">
        <div class="stat-icon pink"><i class="fas fa-chart-bar"></i></div>
        <div><div class="stat-value">$@Model.MonthlyRevenue.ToString("N0")</div><div class="stat-label">Month Revenue</div></div>
    </div>
    <div class="stat-card">
        <div class="stat-icon red"><i class="fas fa-exclamation-triangle"></i></div>
        <div><div class="stat-value">@Model.LowStockItems</div><div class="stat-label">Low Stock Items</div></div>
    </div>
</div>

<div class="dashboard-grid">
    <!-- Revenue Chart -->
    <div class="card">
        <div class="card-header">
            <span class="card-title"><i class="fas fa-chart-line" style="color:var(--primary)"></i> Revenue — Last 6 Months</span>
            <a href="@Url.Action("Index","Billing")" class="btn btn-outline btn-sm">View All</a>
        </div>
        <div class="card-body">
            <div class="chart-container">
                <canvas id="revenueChart"></canvas>
            </div>
        </div>
    </div>

    <!-- Appointment Status -->
    <div class="card">
        <div class="card-header">
            <span class="card-title"><i class="fas fa-chart-pie" style="color:var(--secondary)"></i> Appointments</span>
        </div>
        <div class="card-body">
            <div class="chart-container" style="height:220px;">
                <canvas id="apptChart"></canvas>
            </div>
        </div>
    </div>
</div>

<div class="dashboard-grid" style="margin-top:20px;">
    <!-- Recent Appointments -->
    <div class="card">
        <div class="card-header">
            <span class="card-title">Recent Appointments</span>
            <a href="@Url.Action("Create","Appointment")" class="btn btn-primary btn-sm"><i class="fas fa-plus"></i> New</a>
        </div>
        <div class="table-wrap">
            <table>
                <thead>
                    <tr>
                        <th>Patient</th>
                        <th>Doctor</th>
                        <th>Date & Time</th>
                        <th>Status</th>
                        <th></th>
                    </tr>
                </thead>
                <tbody>
                @if (!Model.RecentAppointments.Any())
                {
                    <tr><td colspan="5" class="no-data"><i class="fas fa-calendar"></i>No appointments yet</td></tr>
                }
                @foreach (var a in Model.RecentAppointments)
                {
                    <tr>
                        <td>
                            <div class="font-semibold">@a.Patient?.FirstName @a.Patient?.LastName</div>
                        </td>
                        <td class="text-muted">Dr. @a.Doctor?.LastName</td>
                        <td>
                            <div>@a.AppointmentDate.ToString("MMM d")</div>
                            <div class="text-xs text-muted">@a.AppointmentTime.ToString(@"hh\:mm")</div>
                        </td>
                        <td>
                            @{
                                var cls = a.Status switch {
                                    HospitalManagementSystem.Models.AppointmentStatus.Completed => "badge-success",
                                    HospitalManagementSystem.Models.AppointmentStatus.Cancelled => "badge-danger",
                                    HospitalManagementSystem.Models.AppointmentStatus.Confirmed => "badge-info",
                                    HospitalManagementSystem.Models.AppointmentStatus.NoShow => "badge-warning",
                                    _ => "badge-secondary"
                                };
                            }
                            <span class="badge @cls">@a.Status</span>
                        </td>
                        <td><a href="@Url.Action("Details","Appointment",new{id=a.Id})" class="btn btn-ghost btn-sm"><i class="fas fa-eye"></i></a></td>
                    </tr>
                }
                </tbody>
            </table>
        </div>
    </div>

    <!-- Active Admissions & Recent Patients -->
    <div style="display:flex;flex-direction:column;gap:20px;">
        <div class="card">
            <div class="card-header">
                <span class="card-title">Active Admissions</span>
                <a href="@Url.Action("Index","Admission")" class="btn btn-outline btn-sm">View All</a>
            </div>
            <div style="padding:0;">
                @if (!Model.ActiveAdmissions.Any())
                {
                    <div class="no-data" style="padding:24px;"><i class="fas fa-bed"></i>No active admissions</div>
                }
                @foreach (var adm in Model.ActiveAdmissions)
                {
                    <div class="flex items-center justify-between" style="padding:12px 18px;border-bottom:1px solid var(--border);">
                        <div>
                            <div class="font-semibold text-sm">@adm.Patient?.FirstName @adm.Patient?.LastName</div>
                            <div class="text-xs text-muted">@adm.Bed?.Ward?.Name — Bed @adm.Bed?.BedNumber</div>
                        </div>
                        <div class="text-right">
                            <div class="text-xs text-muted">@adm.AdmissionDate.ToString("MMM d")</div>
                            <span class="badge badge-info" style="font-size:0.7rem;">@adm.DaysAdmitted days</span>
                        </div>
                    </div>
                }
            </div>
        </div>

        <div class="card">
            <div class="card-header">
                <span class="card-title">New Patients</span>
                <a href="@Url.Action("Create","Patient")" class="btn btn-primary btn-sm"><i class="fas fa-plus"></i></a>
            </div>
            <div style="padding:0;">
                @foreach (var p in Model.RecentPatients)
                {
                    <a href="@Url.Action("Details","Patient",new{id=p.Id})" class="flex items-center gap-3" style="padding:11px 18px;border-bottom:1px solid var(--border);transition:background 0.15s;" onmouseover="this.style.background='#f8fafc'" onmouseout="this.style.background=''">
                        <div class="patient-avatar" style="width:36px;height:36px;font-size:0.85rem;">@p.FirstName[0]</div>
                        <div style="flex:1;">
                            <div class="font-semibold text-sm">@p.FirstName @p.LastName</div>
                            <div class="text-xs text-muted">@p.Phone</div>
                        </div>
                        <span class="badge @(p.Gender == "Male" ? "badge-info" : "badge-purple")" style="font-size:0.7rem;">@p.Gender</span>
                    </a>
                }
            </div>
        </div>
    </div>
</div>

@section Scripts {
<script>
const revenueLabels = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.RevenueByMonth.Keys.ToList()));
const revenueData = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.RevenueByMonth.Values.ToList()));

new Chart(document.getElementById('revenueChart'), {
    type: 'bar',
    data: {
        labels: revenueLabels,
        datasets: [{
            label: 'Revenue ($)',
            data: revenueData,
            backgroundColor: 'rgba(15,111,255,0.15)',
            borderColor: '#0f6fff',
            borderWidth: 2,
            borderRadius: 6,
            fill: true
        }]
    },
    options: {
        responsive: true, maintainAspectRatio: false,
        plugins: { legend: { display: false } },
        scales: {
            y: { beginAtZero: true, grid: { color: 'rgba(0,0,0,0.04)' }, ticks: { callback: v => '$' + v } },
            x: { grid: { display: false } }
        }
    }
});

const apptStatus = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.AppointmentsByStatus));
new Chart(document.getElementById('apptChart'), {
    type: 'doughnut',
    data: {
        labels: Object.keys(apptStatus),
        datasets: [{
            data: Object.values(apptStatus),
            backgroundColor: ['#10b981','#3b82f6','#f59e0b','#ef4444','#8b5cf6'],
            borderWidth: 2, borderColor: '#fff'
        }]
    },
    options: {
        responsive: true, maintainAspectRatio: false,
        plugins: { legend: { position: 'bottom', labels: { padding: 14, font: { size: 12 } } } },
        cutout: '60%'
    }
});
</script>
}
