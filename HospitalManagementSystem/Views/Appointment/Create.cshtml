@model HospitalManagementSystem.ViewModels.AppointmentFormViewModel
@{
    ViewData["Title"] = "Schedule Appointment";
}
<div class="page-header">
    <div class="flex items-center gap-4">
        <a href="@Url.Action("Index")" class="btn btn-outline btn-sm"><i class="fas fa-arrow-left"></i></a>
        <div class="page-title">Schedule Appointment</div>
    </div>
</div>
<div class="card" style="max-width:640px;">
    <div class="card-body">
        <form asp-action="Create" method="post">
            @Html.AntiForgeryToken()
            <div asp-validation-summary="All" class="alert alert-danger"></div>
            <div class="form-group">
                <label asp-for="PatientId" class="form-label required">Patient</label>
                <select asp-for="PatientId" class="form-control form-select">
                    <option value="">Select patient…</option>
                    @foreach(var p in Model.Patients)
                    {<option value="@p.Id">@p.FirstName @p.LastName — @p.Phone</option>}
                </select>
                <span asp-validation-for="PatientId" class="field-validation-error"></span>
            </div>
            <div class="form-group">
                <label asp-for="DoctorId" class="form-label required">Doctor</label>
                <select asp-for="DoctorId" class="form-control form-select">
                    <option value="">Select doctor…</option>
                    @foreach(var d in Model.Doctors)
                    {<option value="@d.Id">Dr. @d.FirstName @d.LastName (@d.Department?.Name) — $@d.ConsultationFee</option>}
                </select>
                <span asp-validation-for="DoctorId" class="field-validation-error"></span>
            </div>
            <div class="form-row">
                <div class="form-group">
                    <label asp-for="AppointmentDate" class="form-label required">Date</label>
                    <input asp-for="AppointmentDate" type="date" class="form-control" min="@DateTime.Today.ToString("yyyy-MM-dd")" />
                    <span asp-validation-for="AppointmentDate" class="field-validation-error"></span>
                </div>
                <div class="form-group">
                    <label asp-for="AppointmentTime" class="form-label required">Time</label>
                    <input asp-for="AppointmentTime" type="time" class="form-control" />
                    <span asp-validation-for="AppointmentTime" class="field-validation-error"></span>
                </div>
            </div>
            <div class="form-group">
                <label asp-for="Reason" class="form-label">Reason for Visit</label>
                <textarea asp-for="Reason" class="form-control" rows="3" placeholder="Describe the reason for this appointment…"></textarea>
            </div>
            <div class="form-group">
                <label asp-for="Status" class="form-label">Status</label>
                <select asp-for="Status" class="form-control form-select" asp-items="Html.GetEnumSelectList<HospitalManagementSystem.Models.AppointmentStatus>()"></select>
            </div>
            <div class="flex gap-3">
                <button type="submit" class="btn btn-primary"><i class="fas fa-calendar-check"></i> Schedule</button>
                <a href="@Url.Action("Index")" class="btn btn-outline">Cancel</a>
            </div>
        </form>
    </div>
</div>
