@model HospitalManagementSystem.ViewModels.PagedResult<HospitalManagementSystem.Models.Appointment>
@using HospitalManagementSystem.Models
@{
    ViewData["Title"] = "Appointments";
}

<div class="page-header">
    <div><div class="page-title">Appointments</div><div class="page-subtitle">@Model.TotalCount total appointments</div></div>
    <a href="@Url.Action("Create")" class="btn btn-primary"><i class="fas fa-calendar-plus"></i> Schedule Appointment</a>
</div>

<div class="filter-bar">
    <form method="get" class="flex items-center gap-3" style="flex:1;flex-wrap:wrap;">
        <div class="search-input-wrap">
            <i class="fas fa-search search-icon"></i>
            <input name="search" value="@Model.Search" class="form-control" placeholder="Search patient or doctor…" style="width:220px;" />
        </div>
        <select name="status" class="form-control form-select" style="width:160px;">
            <option value="">All Statuses</option>
            @foreach(var s in Enum.GetNames<AppointmentStatus>())
            {<option value="@s" selected="@(ViewBag.Status == s)">@s</option>}
        </select>
        <input name="date" type="date" class="form-control" value="@(ViewBag.Date != null ? ((DateTime)ViewBag.Date).ToString("yyyy-MM-dd") : "")" style="width:160px;" />
        <button type="submit" class="btn btn-primary btn-sm">Filter</button>
        <a href="@Url.Action("Index")" class="btn btn-outline btn-sm">Reset</a>
    </form>
</div>

<div class="card">
    <div class="table-wrap">
        <table>
            <thead>
                <tr><th>Code</th><th>Patient</th><th>Doctor</th><th>Date & Time</th><th>Reason</th><th>Status</th><th>Actions</th></tr>
            </thead>
            <tbody>
            @if (!Model.Items.Any())
            {
                <tr><td colspan="7" class="no-data"><i class="fas fa-calendar-times"></i>No appointments found</td></tr>
            }
            @foreach (var a in Model.Items)
            {
                <tr>
                    <td><span class="badge badge-secondary">A@a.Id.ToString("D6")</span></td>
                    <td><a href="@Url.Action("Details","Patient",new{id=a.PatientId})" class="font-semibold" style="color:var(--primary);">@a.Patient?.FirstName @a.Patient?.LastName</a></td>
                    <td class="text-sm">Dr. @a.Doctor?.FirstName @a.Doctor?.LastName</td>
                    <td>
                        <div class="font-semibold text-sm">@a.AppointmentDate.ToString("MMM d, yyyy")</div>
                        <div class="text-xs text-muted">@a.AppointmentTime.ToString(@"hh\:mm")</div>
                    </td>
                    <td class="text-sm text-muted">@(a.Reason != null && a.Reason.Length > 40 ? a.Reason[..40]+"…" : a.Reason ?? "—")</td>
                    <td>
                        @{
                            var cls = a.Status switch {
                                AppointmentStatus.Completed => "badge-success",
                                AppointmentStatus.Cancelled => "badge-danger",
                                AppointmentStatus.Confirmed => "badge-info",
                                AppointmentStatus.NoShow => "badge-warning",
                                _ => "badge-secondary"
                            };
                        }
                        <span class="badge @cls">@a.Status</span>
                    </td>
                    <td>
                        <div class="flex gap-1">
                            <a href="@Url.Action("Details",new{id=a.Id})" class="btn btn-ghost btn-sm"><i class="fas fa-eye"></i></a>
                            @if (a.Status != AppointmentStatus.Cancelled && a.Status != AppointmentStatus.Completed)
                            {
                                <a href="@Url.Action("Edit",new{id=a.Id})" class="btn btn-ghost btn-sm"><i class="fas fa-edit"></i></a>
                                <form asp-action="Cancel" asp-route-id="@a.Id" method="post" style="display:inline;">
                                    @Html.AntiForgeryToken()
                                    <button type="submit" class="btn btn-ghost btn-sm" style="color:var(--danger);" data-confirm="Cancel this appointment?"><i class="fas fa-times"></i></button>
                                </form>
                            }
                        </div>
                    </td>
                </tr>
            }
            </tbody>
        </table>
    </div>
    @if (Model.TotalPages > 1)
    {
        <div class="card-footer flex items-center justify-between">
            <div class="text-sm text-muted">@Model.TotalCount appointments</div>
            <div class="pagination">
                <a href="@Url.Action("Index",new{page=Model.Page-1})" class="page-link @(!Model.HasPrev?"disabled":"")"><i class="fas fa-chevron-left"></i></a>
                @for (int i = Math.Max(1,Model.Page-2); i <= Math.Min(Model.TotalPages,Model.Page+2); i++)
                {<a href="@Url.Action("Index",new{page=i})" class="page-link @(i==Model.Page?"active":"")">@i</a>}
                <a href="@Url.Action("Index",new{page=Model.Page+1})" class="page-link @(!Model.HasNext?"disabled":"")"><i class="fas fa-chevron-right"></i></a>
            </div>
        </div>
    }
</div>
