@model HospitalManagementSystem.Models.Patient
@{
    ViewData["Title"] = Model.FirstName + " " + Model.LastName;
}

<div class="page-header">
    <div class="flex items-center gap-4">
        <a href="@Url.Action("Index")" class="btn btn-outline btn-sm"><i class="fas fa-arrow-left"></i></a>
        <div>
            <div class="page-title">@Model.FirstName @Model.LastName</div>
            <div class="page-subtitle">Patient ID: P@(Model.Id.ToString("D5"))</div>
        </div>
    </div>
    <div class="flex gap-2">
        <a href="@Url.Action("Edit",new{id=Model.Id})" class="btn btn-outline"><i class="fas fa-edit"></i> Edit</a>
        <a href="@Url.Action("Create","Appointment",new{patientId=Model.Id})" class="btn btn-primary"><i class="fas fa-calendar-plus"></i> New Appointment</a>
        <a href="@Url.Action("Create","Billing",new{patientId=Model.Id})" class="btn btn-success"><i class="fas fa-file-invoice"></i> Bill</a>
    </div>
</div>

<div style="display:grid;grid-template-columns:1fr 2fr;gap:20px;">
    <!-- Left: Patient Info -->
    <div style="display:flex;flex-direction:column;gap:16px;">
        <div class="card">
            <div class="card-body text-center" style="padding-bottom:20px;">
                <div class="patient-avatar" style="width:80px;height:80px;font-size:2rem;margin:0 auto 14px;">@Model.FirstName[0]</div>
                <div class="font-bold" style="font-size:1.2rem;">@Model.FirstName @Model.LastName</div>
                <div class="text-muted text-sm mt-1">@Model.Phone</div>
                <div class="info-row" style="justify-content:center;margin-top:10px;">
                    @if (Model.BloodGroup != null) {
                        <span class="badge badge-danger">@Model.BloodGroup</span>
                    }
                    <span class="badge @(Model.Gender=="Male"?"badge-info":"badge-purple")">@Model.Gender</span>
                    <span class="badge badge-secondary">Age @Model.Age</span>
                </div>
            </div>
        </div>

        <div class="card">
            <div class="card-header"><span class="card-title">Contact Info</span></div>
            <div class="card-body" style="padding:16px 20px;">
                <div class="detail-grid">
                    <div class="detail-item"><label>Date of Birth</label><span>@Model.DateOfBirth.ToString("MMM d, yyyy")</span></div>
                    <div class="detail-item"><label>Gender</label><span>@Model.Gender</span></div>
                    <div class="detail-item" style="grid-column:span 2;"><label>Email</label><span>@(Model.Email ?? "—")</span></div>
                    <div class="detail-item" style="grid-column:span 2;"><label>Address</label><span>@(Model.Address ?? "—")</span></div>
                    <div class="detail-item"><label>Emergency Contact</label><span>@(Model.EmergencyContact ?? "—")</span></div>
                    <div class="detail-item"><label>Emergency Phone</label><span>@(Model.EmergencyPhone ?? "—")</span></div>
                </div>
            </div>
        </div>

        @if (!string.IsNullOrEmpty(Model.MedicalHistory) || !string.IsNullOrEmpty(Model.Allergies))
        {
            <div class="card">
                <div class="card-header"><span class="card-title">Medical Info</span></div>
                <div class="card-body" style="padding:16px 20px;">
                    @if (!string.IsNullOrEmpty(Model.Allergies))
                    {
                        <div class="mb-3">
                            <label class="form-label" style="font-size:0.75rem;text-transform:uppercase;letter-spacing:0.05em;color:var(--danger);">⚠ Allergies</label>
                            <p class="text-sm">@Model.Allergies</p>
                        </div>
                    }
                    @if (!string.IsNullOrEmpty(Model.MedicalHistory))
                    {
                        <div>
                            <label class="form-label" style="font-size:0.75rem;text-transform:uppercase;letter-spacing:0.05em;color:var(--text-muted);">Medical History</label>
                            <p class="text-sm">@Model.MedicalHistory</p>
                        </div>
                    }
                </div>
            </div>
        }
    </div>

    <!-- Right: Activity -->
    <div style="display:flex;flex-direction:column;gap:16px;">
        <!-- Appointments -->
        <div class="card">
            <div class="card-header">
                <span class="card-title">Appointments (@Model.Appointments.Count)</span>
                <a href="@Url.Action("Create","Appointment",new{patientId=Model.Id})" class="btn btn-primary btn-sm"><i class="fas fa-plus"></i></a>
            </div>
            <div class="table-wrap">
                <table>
                    <thead>
                        <tr><th>Date</th><th>Doctor</th><th>Reason</th><th>Status</th><th></th></tr>
                    </thead>
                    <tbody>
                    @if (!Model.Appointments.Any())
                    {
                        <tr><td colspan="5" class="no-data" style="padding:20px;"><i class="fas fa-calendar"></i>No appointments</td></tr>
                    }
                    @foreach (var a in Model.Appointments.OrderByDescending(x => x.AppointmentDate).Take(5))
                    {
                        <tr>
                            <td>@a.AppointmentDate.ToString("MMM d, yyyy")</td>
                            <td class="text-sm">Dr. @a.Doctor?.LastName</td>
                            <td class="text-sm text-muted">@(a.Reason ?? "—")</td>
                            <td>
                                @{
                                    var bc = a.Status switch {
                                        HospitalManagementSystem.Models.AppointmentStatus.Completed => "badge-success",
                                        HospitalManagementSystem.Models.AppointmentStatus.Cancelled => "badge-danger",
                                        HospitalManagementSystem.Models.AppointmentStatus.Confirmed => "badge-info",
                                        _ => "badge-secondary"
                                    };
                                }
                                <span class="badge @bc">@a.Status</span>
                            </td>
                            <td><a href="@Url.Action("Details","Appointment",new{id=a.Id})" class="btn btn-ghost btn-sm"><i class="fas fa-eye"></i></a></td>
                        </tr>
                    }
                    </tbody>
                </table>
            </div>
        </div>

        <!-- Bills -->
        <div class="card">
            <div class="card-header">
                <span class="card-title">Bills (@Model.Bills.Count)</span>
                <a href="@Url.Action("Create","Billing",new{patientId=Model.Id})" class="btn btn-success btn-sm"><i class="fas fa-plus"></i></a>
            </div>
            <div class="table-wrap">
                <table>
                    <thead>
                        <tr><th>Bill No.</th><th>Date</th><th>Amount</th><th>Paid</th><th>Status</th><th></th></tr>
                    </thead>
                    <tbody>
                    @if (!Model.Bills.Any())
                    {
                        <tr><td colspan="6" class="no-data" style="padding:20px;"><i class="fas fa-file-invoice"></i>No bills</td></tr>
                    }
                    @foreach (var b in Model.Bills.OrderByDescending(x => x.BillDate).Take(5))
                    {
                        var total = b.SubTotal - b.Discount + (b.SubTotal - b.Discount) * b.TaxPercent / 100;
                        <tr>
                            <td><span class="badge badge-secondary">B@(b.Id.ToString("D6"))</span></td>
                            <td class="text-sm">@b.BillDate.ToString("MMM d")</td>
                            <td class="font-semibold">$@total.ToString("N2")</td>
                            <td class="text-sm">$@b.PaidAmount.ToString("N2")</td>
                            <td>
                                @{
                                    var bs = b.Status switch {
                                        HospitalManagementSystem.Models.BillStatus.Paid => "badge-success",
                                        HospitalManagementSystem.Models.BillStatus.Partial => "badge-warning",
                                        HospitalManagementSystem.Models.BillStatus.Cancelled => "badge-danger",
                                        _ => "badge-secondary"
                                    };
                                }
                                <span class="badge @bs">@b.Status</span>
                            </td>
                            <td><a href="@Url.Action("Details","Billing",new{id=b.Id})" class="btn btn-ghost btn-sm"><i class="fas fa-eye"></i></a></td>
                        </tr>
                    }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>
