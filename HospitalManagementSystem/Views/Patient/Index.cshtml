@model HospitalManagementSystem.ViewModels.PagedResult<HospitalManagementSystem.Models.Patient>
@{
    ViewData["Title"] = "Patients";
}

<div class="page-header">
    <div>
        <div class="page-title">Patients</div>
        <div class="page-subtitle">@Model.TotalCount registered patients</div>
    </div>
    <a href="@Url.Action("Create")" class="btn btn-primary"><i class="fas fa-user-plus"></i> Register Patient</a>
</div>

<div class="filter-bar">
    <form method="get" class="search-bar" style="flex:1;">
        <div class="search-input-wrap" style="flex:1;max-width:340px;">
            <i class="fas fa-search search-icon"></i>
            <input name="search" value="@Model.Search" class="form-control" placeholder="Search by name, phone or email…" />
        </div>
        <button type="submit" class="btn btn-primary btn-sm">Search</button>
        @if (!string.IsNullOrEmpty(Model.Search))
        {
            <a href="@Url.Action("Index")" class="btn btn-outline btn-sm">Clear</a>
        }
    </form>
</div>

<div class="card">
    <div class="table-wrap">
        <table>
            <thead>
                <tr>
                    <th>Patient</th>
                    <th>ID</th>
                    <th>Age / Gender</th>
                    <th>Blood Group</th>
                    <th>Phone</th>
                    <th>Registered</th>
                    <th>Actions</th>
                </tr>
            </thead>
            <tbody>
                @if (!Model.Items.Any())
                {
                    <tr><td colspan="7" class="no-data"><i class="fas fa-user-injured"></i>No patients found</td></tr>
                }
                @foreach (var p in Model.Items)
                {
                    <tr>
                        <td>
                            <div class="flex items-center gap-3">
                                <div class="patient-avatar" style="width:38px;height:38px;font-size:0.9rem;">@p.FirstName[0]</div>
                                <div>
                                    <div class="font-semibold">@p.FirstName @p.LastName</div>
                                    <div class="text-xs text-muted">@p.Email</div>
                                </div>
                            </div>
                        </td>
                        <td><span class="badge badge-secondary">P@p.Id.ToString("D5")</span></td>
                        <td>@p.Age yrs / <span class="badge @(p.Gender=="Male"?"badge-info":"badge-purple")" style="font-size:0.7rem;">@p.Gender</span></td>
                        <td>@(p.BloodGroup ?? "—")</td>
                        <td>@p.Phone</td>
                        <td class="text-muted text-sm">@p.RegisteredAt.ToString("MMM d, yyyy")</td>
                        <td>
                            <div class="flex gap-2">
                                <a href="@Url.Action("Details",new{id=p.Id})" class="btn btn-ghost btn-sm" title="View"><i class="fas fa-eye"></i></a>
                                <a href="@Url.Action("Edit",new{id=p.Id})" class="btn btn-ghost btn-sm" title="Edit"><i class="fas fa-edit"></i></a>
                                <a href="@Url.Action("Create","Appointment",new{patientId=p.Id})" class="btn btn-ghost btn-sm" title="New Appointment" style="color:var(--primary)"><i class="fas fa-calendar-plus"></i></a>
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
    @if (Model.TotalPages > 1)
    {
        <div class="card-footer flex items-center justify-between">
            <div class="text-sm text-muted">Showing @((Model.Page-1)*Model.PageSize+1)–@(Math.Min(Model.Page*Model.PageSize,Model.TotalCount)) of @Model.TotalCount</div>
            <div class="pagination">
                <a href="@Url.Action("Index",new{page=Model.Page-1,search=Model.Search})" class="page-link @(!Model.HasPrev?"disabled":"")"><i class="fas fa-chevron-left"></i></a>
                @for (int i = Math.Max(1,Model.Page-2); i <= Math.Min(Model.TotalPages,Model.Page+2); i++)
                {
                    <a href="@Url.Action("Index",new{page=i,search=Model.Search})" class="page-link @(i==Model.Page?"active":"")">@i</a>
                }
                <a href="@Url.Action("Index",new{page=Model.Page+1,search=Model.Search})" class="page-link @(!Model.HasNext?"disabled":"")"><i class="fas fa-chevron-right"></i></a>
            </div>
        </div>
    }
</div>
