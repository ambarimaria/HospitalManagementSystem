@model HospitalManagementSystem.Models.Department
@{
    ViewData["Title"] = "Add Department";
}
<div class="page-header">
    <div class="flex items-center gap-4">
        <a href="@Url.Action("Index")" class="btn btn-outline btn-sm"><i class="fas fa-arrow-left"></i></a>
        <div class="page-title">Add Department</div>
    </div>
</div>
<div class="card" style="max-width:480px;">
    <div class="card-body">
        <form asp-action="Create" method="post">
            @Html.AntiForgeryToken()
            <div asp-validation-summary="All" class="alert alert-danger"></div>
            <div class="form-group"><label asp-for="Name" class="form-label required"></label><input asp-for="Name" class="form-control" placeholder="e.g. Cardiology"/></div>
            <div class="form-group"><label asp-for="Description" class="form-label">Description</label><textarea asp-for="Description" class="form-control" rows="2" placeholder="Brief description…"></textarea></div>
            <div class="form-group"><label asp-for="Icon" class="form-label">Icon (emoji)</label><input asp-for="Icon" class="form-control" placeholder="🏥" style="width:80px;font-size:1.5rem;text-align:center;"/></div>
            <div class="flex gap-3"><button type="submit" class="btn btn-primary"><i class="fas fa-save"></i> Create Department</button><a href="@Url.Action("Index")" class="btn btn-outline">Cancel</a></div>
        </form>
    </div>
</div>
