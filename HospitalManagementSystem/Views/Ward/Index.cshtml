@model List<HospitalManagementSystem.Models.Ward>
@{
    ViewData["Title"] = "Wards & Beds";
}
<div class="page-header">
    <div><div class="page-title">Wards & Beds</div><div class="page-subtitle">@Model.Count active wards</div></div>
    <a href="@Url.Action("Create","Admission")" class="btn btn-primary"><i class="fas fa-bed"></i> Admit Patient</a>
</div>

<div style="display:grid;grid-template-columns:repeat(auto-fill,minmax(340px,1fr));gap:20px;">
@foreach(var w in Model)
{
    var available = w.Beds.Count(b => b.Status == HospitalManagementSystem.Models.BedStatus.Available);
    var total = w.Beds.Count;
    var pct = total > 0 ? (int)((total - available) * 100.0 / total) : 0;
    <div class="card">
        <div class="card-header">
            <div>
                <div class="card-title">@w.Name</div>
                <div class="text-xs text-muted">Ward @w.WardNumber · @w.WardType</div>
            </div>
            <div class="text-right">
                <div class="font-bold" style="font-size:1.1rem;">@available<span class="text-muted font-semibold text-sm">/@total</span></div>
                <div class="text-xs text-muted">beds free</div>
            </div>
        </div>
        <div class="card-body" style="padding-bottom:12px;">
            <div style="height:6px;background:var(--border);border-radius:3px;margin-bottom:14px;overflow:hidden;">
                <div style="height:100%;width:@pct%;background:@(pct>80?"var(--danger)":pct>60?"var(--warning)":"var(--success)");border-radius:3px;transition:width 0.5s;"></div>
            </div>
            <div class="bed-grid" style="grid-template-columns:repeat(auto-fill,minmax(64px,1fr));">
            @foreach(var bed in w.Beds)
            {
                var bedCls = bed.Status switch {
                    HospitalManagementSystem.Models.BedStatus.Available => "bed-available",
                    HospitalManagementSystem.Models.BedStatus.Occupied => "bed-occupied",
                    HospitalManagementSystem.Models.BedStatus.Maintenance => "bed-maintenance",
                    HospitalManagementSystem.Models.BedStatus.Reserved => "bed-reserved",
                    _ => ""
                };
                <div class="bed-cell @bedCls" title="Bed @bed.BedNumber — @bed.Status">
                    <span class="bed-icon">🛏</span>
                    <span>@bed.BedNumber</span>
                </div>
            }
            </div>
        </div>
        <div class="card-footer flex items-center justify-between">
            <div class="flex gap-2">
                <span class="badge badge-success" style="font-size:0.7rem;">✓ @w.Beds.Count(b=>b.Status==HospitalManagementSystem.Models.BedStatus.Available) Free</span>
                <span class="badge badge-danger" style="font-size:0.7rem;">⬤ @w.Beds.Count(b=>b.Status==HospitalManagementSystem.Models.BedStatus.Occupied) Occupied</span>
            </div>
            <a href="@Url.Action("Details",new{id=w.Id})" class="btn btn-outline btn-sm">Details</a>
        </div>
    </div>
}
</div>
